                    <Option id="0" displayName="ddl_auto_off">
                        <Entry varId="autoLight" value="0" overrideGroup="DDLantern" />
                    </Option>
                    <Option id="1" displayName="ddl_auto_equipped">
                        <Entry varId="autoLight" value="1" overrideGroup="DDLantern" />
                    </Option>
                    <Option id="2" displayName="ddl_auto_night">
                        <Entry varId="autoLight" value="2" overrideGroup="DDLantern" />
