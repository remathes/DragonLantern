            <Preset id="0" displayName="ddl_preset_default">
                <Entry varId="enabled" value="true" overrideGroup="DDLantern" />
                <Entry varId="position" value="0" overrideGroup="DDLantern" />
                <Entry varId="showUnequipped" value="false" overrideGroup="DDLantern" />
                <Entry varId="autoLight" value="1" overrideGroup="DDLantern" />
                <Entry varId="requireOil" value="true" overrideGroup="DDLantern" />
                <Entry varId="autoRefill" value="true" overrideGroup="DDLantern" />
                <Entry varId="burnHours" value="8" overrideGroup="DDLantern" />
                <Entry varId="douseInWater" value="true" overrideGroup="DDLantern" />
                <Entry varId="hideInScenes" value="true" overrideGroup="DDLantern" />
                <Entry varId="merchants" value="true" overrideGroup="DDLantern" />
                <Entry varId="brightness" value="80" overrideGroup="DDLantern" />
                <Entry varId="radius" value="12" overrideGroup="DDLantern" />
                <Entry varId="castShadows" value="false" overrideGroup="DDLantern" />
                <Entry varId="swing" value="true" overrideGroup="DDLantern" />
