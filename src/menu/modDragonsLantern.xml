                    </Option>
                    <Option id="3" displayName="ddl_up_roll180">
                        <Entry varId="modelUp" value="3" overrideGroup="DDLantern" />
                    </Option>
                </OptionsArray>
            </Var>
            <Var id="offsetForward" displayName="ddl_offset_forward" displayType="SLIDER;-20;20;40" value="0" overrideGroup="DDLantern" />
            <Var id="offsetUp" displayName="ddl_offset_up" displayType="SLIDER;-20;20;40" value="0" overrideGroup="DDLantern" />
            <Var id="offsetOut" displayName="ddl_offset_out" displayType="SLIDER;-20;20;40" value="0" overrideGroup="DDLantern" />
        </VisibleVars>
    </Group>
</UserConfig>
