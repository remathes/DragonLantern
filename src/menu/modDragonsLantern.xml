                </OptionsArray>
            </Var>
            <Var id="requireOil" displayName="ddl_require_oil" displayType="TOGGLE" value="true" overrideGroup="DDLantern" />
            <Var id="autoRefill" displayName="ddl_auto_refill" displayType="TOGGLE" value="true" overrideGroup="DDLantern" />
            <Var id="burnHours" displayName="ddl_burn_hours" displayType="SLIDER;1;48;47" value="8" overrideGroup="DDLantern" />
