            <Var id="showUnequipped" displayName="ddl_show_unequipped" displayType="TOGGLE" value="false" overrideGroup="DDLantern" />
            <Var id="position" displayName="ddl_position" displayType="OPTIONS" value="0" overrideGroup="DDLantern">
                <OptionsArray>
                    <Option id="0" displayName="ddl_pos_left">
                        <Entry varId="position" value="0" overrideGroup="DDLantern" />
                    </Option>
                    <Option id="1" displayName="ddl_pos_right">
                        <Entry varId="position" value="1" overrideGroup="DDLantern" />
                    </Option>
                    <Option id="2" displayName="ddl_pos_back">
